+        "workload": workload,
+        "pair_index": pair_index,
+        "steady_state_ns": steady_state_ns,
+        "p99_script_render_ns": p99_script_render_ns,
+        "first_window_ns": first_window_ns,
+        "hot_reload_ns": hot_reload_ns,
