+JSJitHelperStatus JS_JitHelperGetGlobal(JSJitExecFrame *frame,
+                                        uint32_t stack_map_id,
+                                        uint32_t output, uint32_t atom)
+{
+    JSFunctionBytecode *b;
+    JSStackFrame *sf;
+    JSValue *out, result;
+
+    if (qjsjit_validate_helper_frame(frame, true, stack_map_id, &b, &sf) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    qjsjit_count_helper(frame, JS_JIT_HELPER_GET_GLOBAL);
+    if (!qjsjit_resolve_slot(frame, b, output, &out) ||
+        !qjsjit_valid_atom(frame->rt, (JSAtom)atom))
+        return qjsjit_reject_helper(frame, "invalid JIT global get");
+    if (!JS_IsUndefined(*out))
+        return qjsjit_reject_helper(frame, "occupied JIT global output");
+    if (qjsjit_stress_gc(frame) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    result = JS_GetGlobalVar(frame->ctx, (JSAtom)atom, true);
+    if (JS_IsException(result)) {
+        *out = JS_UNDEFINED;
+        qjsjit_stress_gc_after_exception(frame);
+        return JS_JIT_HELPER_EXCEPTION;
+    }
+    *out = result;
+    return qjsjit_finish_output(frame, out);
+}
