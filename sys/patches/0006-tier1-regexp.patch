+JSJitHelperStatus JS_JitHelperRegexp(JSJitExecFrame *frame,
+                                     uint32_t stack_map_id, uint32_t output,
+                                     uint32_t pattern, uint32_t bytecode)
+{
+    JSFunctionBytecode *b;
+    JSStackFrame *sf;
+    JSValue *out, *pat, *bc;
+    JSValue result;
+
+    if (qjsjit_validate_helper_frame(frame, true, stack_map_id, &b, &sf) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    qjsjit_count_helper(frame, JS_JIT_HELPER_REGEXP);
+    if (!qjsjit_resolve_slot(frame, b, output, &out) ||
+        !qjsjit_resolve_slot(frame, b, pattern, &pat) ||
+        !qjsjit_resolve_slot(frame, b, bytecode, &bc) ||
+        out != pat || out == bc || pat == bc)
+        return qjsjit_reject_helper(frame, "invalid JIT regexp slots");
+    if (qjsjit_stress_gc(frame) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    result = js_regexp_constructor_internal(frame->ctx, JS_UNDEFINED,
+                                            *pat, *bc);
+    *bc = JS_UNDEFINED;
+    if (JS_IsException(result)) {
+        *out = JS_UNDEFINED;
+        qjsjit_stress_gc_after_exception(frame);
+        return JS_JIT_HELPER_EXCEPTION;
+    }
+    *out = result;
+    return qjsjit_finish_output(frame, out);
+}
 #endif
 
