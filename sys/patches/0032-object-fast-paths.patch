+/* Versioned allocation and array-method fast paths (ABI 1.25). Every entry
+ * either completes the exact interpreter effect or misses with no observable
+ * effect; it never throws, calls user code or reenters the VM. `literal` may
+ * run the same allocation-triggered cycle collection as OP_object (C
+ * finalizers only) and allocates without throwing. `retain_shape` keeps a
+ * literal's final hashed shape in the bounded per-context JIT shape cache.
+ * The array entries only duplicate references and, for push, may grow the
+ * element buffer without throwing. Inputs are borrowed; a hit returns an owned
+ * value in `out`, a miss leaves `out` undefined. */
+#define QJSJIT_OBJECT_API_VERSION 1u
+#define JS_JIT_OBJECT_LITERAL_MAX_FIELDS 16u
+#define JS_JIT_OBJECT_EFFECT_ALLOCATE (1U << 0)
+#define JS_JIT_OBJECT_EFFECT_COLLECT (1U << 1)
+
+typedef enum JSJitObjectStatus {
+    JS_JIT_OBJECT_INVALID = -1,
+    JS_JIT_OBJECT_MISS = 0,
+    JS_JIT_OBJECT_OK = 1,
+} JSJitObjectStatus;
+
+typedef int JSJitObjectLiteralFunc(JSContext *ctx, const uint32_t *atoms,
+                                   const JSValue *values, uint32_t count,
+                                   JSValue *out);
+typedef int JSJitObjectRetainShapeFunc(JSContext *ctx, const JSValue *object);
+typedef int JSJitArrayMethodFunc(JSContext *ctx, const JSValue *receiver,
+                                 uint32_t atom, JSValue *out);
+typedef int JSJitArrayPushFunc(JSContext *ctx, const JSValue *function,
+                               const JSValue *receiver, const JSValue *value,
+                               JSValue *out);
+typedef int JSJitArrayPushMethodFunc(JSContext *ctx, const JSValue *receiver,
+                                     uint32_t atom, const JSValue *value,
+                                     JSValue *out);
+
+typedef struct JSJitObjectAPI {
+    uint32_t struct_size;
+    uint32_t version;
+    uint32_t effects;
+    uint32_t max_literal_fields;
+    JSJitObjectLiteralFunc *literal;
+    JSJitObjectRetainShapeFunc *retain_shape;
+    JSJitArrayMethodFunc *array_method;
+    JSJitArrayPushFunc *array_push;
+    JSJitArrayPushMethodFunc *array_push_method;
+} JSJitObjectAPI;
+
+JS_EXTERN const JSJitObjectAPI *JS_JitGetObjectAPI(uint32_t version);
