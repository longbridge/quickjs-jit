diff --git a/quickjs.c b/quickjs.c
index 5fa9d92..4fbd055 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -19288,6 +19288,20 @@ static JSJitHelperStatus qjsjit_validate_helper_frame(
     return JS_JIT_HELPER_OK;
 }
 
+static void qjsjit_unpoison_slot(JSValue *value)
+{
+#if defined(__has_feature)
+#if __has_feature(memory_sanitizer)
+    extern void __msan_unpoison(const volatile void *, size_t);
+    __msan_unpoison(value, sizeof(*value));
+#else
+    (void)value;
+#endif
+#else
+    (void)value;
+#endif
+}
+
 static bool qjsjit_resolve_slot(JSJitExecFrame *frame,
                                 JSFunctionBytecode *b, uint32_t slot,
                                 JSValue **value)
@@ -19300,16 +19314,19 @@ static bool qjsjit_resolve_slot(JSJitExecFrame *frame,
         return false;
     if ((uint64_t)slot < local_base) {
         *value = (JSValue *)frame->arg_buf + slot;
+        qjsjit_unpoison_slot(*value);
         return true;
     }
     if ((uint64_t)slot < stack_base) {
         *value = frame->var_buf + (slot - (uint32_t)local_base);
+        qjsjit_unpoison_slot(*value);
         return true;
     }
     stack_count = (uint32_t)(frame->stack_top - frame->stack_base);
     if ((uint64_t)slot - stack_base >= stack_count)
         return false;
     *value = frame->stack_base + ((uint64_t)slot - stack_base);
+    qjsjit_unpoison_slot(*value);
     return true;
 }
 
@@ -20271,8 +20288,10 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
     if (argc >= 0 && argc <= 8 && !rt->jit_suspended && rt->jit_backend_vtable &&
         rt->jit_backend_vtable->record_feedback) {
         uint32_t call_types[8];
-        for (i = 0; i < argc; i++)
+        for (i = 0; i < argc; i++) {
+            qjsjit_unpoison_slot(&arg_buf[i]);
             call_types[i] = qjsjit_feedback_type(arg_buf[i]);
+        }
         qjsjit_record_feedback(rt, b, JS_JIT_FEEDBACK_CALL, 0, 0,
                                call_types, (uint32_t)argc, 0);
     }
