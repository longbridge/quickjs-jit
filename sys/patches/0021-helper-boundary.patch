+/* Decode the instruction stream once with exactly the scan's rules. Offsets
+ * after an undecodable instruction stay clear, so every query answers as the
+ * linear scan would. Allocation failure leaves the map absent (scan
+ * fallback); it never raises an exception or changes JS-visible state. */
+static uint8_t *qjsjit_build_pc_boundary_map(JSFunctionBytecode *b)
+{
+    uint8_t *map;
+    int offset = 0;
+
+    if (!b->realm || b->byte_code_len < 0)
+        return NULL;
+    map = js_mallocz_rt(b->realm->rt, ((size_t)b->byte_code_len >> 3) + 1);
+    if (!map)
+        return NULL;
+    for (;;) {
+        const JSJitOpcodeInfo *info;
+        uint8_t opcode;
+
+        /* Mark first: reaching byte_code_len means an exact decode. */
+        map[(size_t)offset >> 3] |= (uint8_t)(1u << (offset & 7));
+        if (offset >= b->byte_code_len)
+            break;
+        opcode = b->byte_code_buf[offset];
+        if (opcode >= countof(qjsjit_opcode_table))
+            break;
+        info = &qjsjit_opcode_table[opcode];
+        if (!info->size || info->size > b->byte_code_len - offset)
+            break;
+        offset += info->size;
+    }
+    b->jit_pc_boundary_map = map;
+    return map;
+}
+
+static inline bool qjsjit_valid_pc(JSFunctionBytecode *b, const uint8_t *pc,
+                                   bool allow_end)
+{
+    uintptr_t start = (uintptr_t)b->byte_code_buf;
+    uintptr_t end = start + (size_t)b->byte_code_len;
+    uintptr_t value = (uintptr_t)pc;
+    const uint8_t *map;
+    size_t offset;
+
+    if (value < start || (allow_end ? value > end : value >= end))
+        return false;
+    map = b->jit_pc_boundary_map;
+    if (unlikely(!map)) {
+        map = qjsjit_build_pc_boundary_map(b);
+        if (!map)
+            return qjsjit_valid_pc_scan(b, pc, allow_end);
+    }
+    offset = value - start;
+    return (map[offset >> 3] >> (offset & 7)) & 1;
+}
