+#define QJSJIT_INLINE_ARENA_ALIGN 16
+#define QJSJIT_INLINE_ARENA_MIN_SIZE (32 * 1024)
+
+#if defined(__SANITIZE_ADDRESS__)
+#define QJSJIT_INLINE_ARENA_ENABLED 0
+#elif defined(__has_feature)
+#if __has_feature(address_sanitizer) || __has_feature(memory_sanitizer)
+#define QJSJIT_INLINE_ARENA_ENABLED 0
+#endif
+#endif
+#ifndef QJSJIT_INLINE_ARENA_ENABLED
+#define QJSJIT_INLINE_ARENA_ENABLED 1
+#endif
+
+/* Reserve zeroed shadow-frame storage. Frames are strictly nested, so the
+ * arena is a bump stack: a frame's storage never moves while it is live
+ * (captured JSVarRef pointers rely on this). The arena only grows while it
+ * is empty; a frame that does not fit uses the heap. Failure is a pre-effect
+ * miss, exactly like the previous per-call allocation. */
+static JSJitInlineState *qjsjit_inline_alloc(JSRuntime *rt, size_t bytes)
+{
+    JSJitInlineState *state;
+    size_t aligned, used, size;
+
+    aligned = (bytes + QJSJIT_INLINE_ARENA_ALIGN - 1) &
+        ~(size_t)(QJSJIT_INLINE_ARENA_ALIGN - 1);
+    used = rt->jit_inline_arena_used;
+    if (QJSJIT_INLINE_ARENA_ENABLED && aligned >= bytes &&
+        aligned <= JS_JIT_INLINE_MAX_BYTES + QJSJIT_INLINE_ARENA_ALIGN) {
+        if (used == 0 && aligned > rt->jit_inline_arena_size) {
+            size = QJSJIT_INLINE_ARENA_MIN_SIZE;
+            while (size < aligned)
+                size <<= 1;
+            js_free_rt(rt, rt->jit_inline_arena);
+            rt->jit_inline_arena_size = 0;
+            rt->jit_inline_arena = js_malloc_rt(rt, size);
+            if (rt->jit_inline_arena)
+                rt->jit_inline_arena_size = size;
+        }
+        if (rt->jit_inline_arena &&
+            aligned <= rt->jit_inline_arena_size - used) {
+            state = (JSJitInlineState *)(rt->jit_inline_arena + used);
+            memset(state, 0, bytes);
+            state->arena_mark = used;
+            state->arena_bytes = aligned;
+            rt->jit_inline_arena_used = used + aligned;
+            return state;
+        }
+    }
+    return js_mallocz_rt(rt, bytes);
+}
+
+/* Callers release after their depth decrement, so depth zero proves that no
+ * reserved frame (published or not) still uses the arena. */
+static void qjsjit_inline_release(JSRuntime *rt, JSJitInlineState *state)
+{
+    if (!state->arena_bytes) {
+        js_free_rt(rt, state);
+        return;
+    }
+    if (state->arena_mark + state->arena_bytes == rt->jit_inline_arena_used)
+        rt->jit_inline_arena_used = state->arena_mark;
+    if (rt->jit_inline_depth == 0)
+        rt->jit_inline_arena_used = 0;
+}
