+/* A leaf: no allocation, property lookup, exception, finalization, callback
+ * or VM reentry. The only effects on a VALUE result are the ones the built-in
+ * %ArrayIteratorPrototype%.next performs for an in-bounds dense element: the
+ * iterator index advances and the element is duplicated into *out. Every
+ * other state misses before touching anything. */
+static int qjsjit_array_values_next(JSContext *ctx, const JSValue *iterator,
+                                    const JSValue *next_method, JSValue *out)
+{
+    JSObject *iterator_object, *method, *array;
+    JSArrayIteratorData *it;
+    uint32_t idx;
+
+    if (!ctx || !iterator || !next_method || !out)
+        return JS_JIT_ITERATOR_QUERY_INVALID;
+    if (JS_VALUE_GET_TAG(*iterator) != JS_TAG_OBJECT ||
+        JS_VALUE_GET_TAG(*next_method) != JS_TAG_OBJECT)
+        return JS_JIT_ITERATOR_QUERY_MISS;
+    iterator_object = JS_VALUE_GET_OBJ(*iterator);
+    method = JS_VALUE_GET_OBJ(*next_method);
+    if (iterator_object->class_id != JS_CLASS_ARRAY_ITERATOR ||
+        method->class_id != JS_CLASS_C_FUNCTION ||
+        method->u.cfunc.cproto != JS_CFUNC_iterator_next ||
+        method->u.cfunc.c_function.iterator_next != js_array_iterator_next)
+        return JS_JIT_ITERATOR_QUERY_MISS;
+    it = iterator_object->u.array_iterator_data;
+    if (!it || it->kind != JS_ITERATOR_KIND_VALUE ||
+        JS_VALUE_GET_TAG(it->obj) != JS_TAG_OBJECT)
+        return JS_JIT_ITERATOR_QUERY_MISS;
+    array = JS_VALUE_GET_OBJ(it->obj);
+    /* A fast Array's own `length` data property is never below its dense
+     * count, so an in-bounds dense index is exactly the built-in's
+     * `idx < length` element read, with no prototype or getter lookup. */
+    if (array->class_id != JS_CLASS_ARRAY || !array->fast_array)
+        return JS_JIT_ITERATOR_QUERY_MISS;
+    idx = it->idx;
+    if (idx >= array->u.array.count)
+        return JS_JIT_ITERATOR_QUERY_MISS;
+    it->idx = idx + 1;
+    *out = js_dup(array->u.array.u.values[idx]);
+    return JS_JIT_ITERATOR_QUERY_VALUE;
+}
+
+const JSJitIteratorAPI *JS_JitGetIteratorAPI(uint32_t version)
+{
+    static const JSJitIteratorAPI api = {
+        sizeof(JSJitIteratorAPI), QJSJIT_ITERATOR_API_VERSION, 0, 0,
+        qjsjit_array_values_next,
+    };
+    return version == QJSJIT_ITERATOR_API_VERSION ? &api : NULL;
+}
