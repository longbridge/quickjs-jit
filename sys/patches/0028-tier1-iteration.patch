+/* Exact interpreter stack effects for the synchronous iteration opcodes.
+ * `depth` is the bytecode-visible stack depth before the opcode. Native code
+ * materializes the complete frame, including the opcode's push window (which
+ * must still be JS_UNDEFINED), and reloads the affected slots afterwards. The
+ * interpreter routines run directly on the materialized stack, so every owner
+ * stays C-visible across user iterator code, allocation and cycle collection.
+ * On a language exception every slot at or above the opcode's interpreter
+ * exception depth is JS_UNDEFINED and every slot below it is exactly what the
+ * interpreter's unwinder observes, including the for-of catch offset that
+ * closes the iterator with a throw completion. */
+JSJitHelperStatus JS_JitHelperIteratorOp(JSJitExecFrame *frame,
+                                         uint32_t stack_map_id, uint32_t depth,
+                                         uint32_t opcode, uint32_t operand,
+                                         uint32_t reserved)
+{
+    JSFunctionBytecode *b;
+    JSStackFrame *sf;
+    JSContext *ctx;
+    JSValue *sp;
+    uint32_t visible, pops, window, exception_depth, success_depth, i;
+    int status;
+
+    if (qjsjit_validate_helper_frame(frame, true, stack_map_id, &b, &sf) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    qjsjit_count_helper(frame, JS_JIT_HELPER_ITERATOR_OP);
+    ctx = frame->ctx;
+    switch (opcode) {
+    case OP_for_of_start:
+        pops = 1;
+        window = 2;
+        break;
+    case OP_for_of_next:
+        if (operand > UINT8_MAX)
+            return qjsjit_reject_helper(frame, "invalid JIT for-of offset");
+        pops = 3 + operand;
+        window = 2;
+        break;
+    case OP_for_in_start:
+        pops = 1;
+        window = 0;
+        break;
+    case OP_for_in_next:
+        pops = 1;
+        window = 2;
+        break;
+    case OP_iterator_close:
+        pops = 3;
+        window = 0;
+        break;
+    default:
+        return qjsjit_reject_helper(frame, "invalid JIT iterator opcode");
+    }
+    if (opcode != OP_for_of_next && operand != 0)
+        return qjsjit_reject_helper(frame, "invalid JIT iterator operand");
+    visible = (uint32_t)(frame->stack_top - frame->stack_base);
+    if (reserved != 0 || depth < pops || depth > b->stack_size ||
+        visible > b->stack_size || depth + window > visible)
+        return qjsjit_reject_helper(frame, "invalid JIT iterator stack");
+    sp = frame->stack_base + depth;
+    for (i = 0; i < window; i++) {
+        if (!JS_IsUndefined(sp[i]))
+            return qjsjit_reject_helper(frame, "occupied JIT iterator output");
+    }
+    if (opcode == OP_iterator_close) {
+        /* iter_obj next catch_offset -> ; the catch offset is dropped and the
+         * next method released before closing, exactly as the interpreter
+         * does, so neither is live if closing throws. */
+        exception_depth = depth - 2;
+        success_depth = depth - 3;
+        JS_FreeValue(ctx, sp[-1]);
+        sp[-1] = JS_UNDEFINED;
+        JS_FreeValue(ctx, sp[-2]);
+        sp[-2] = JS_UNDEFINED;
+    } else {
+        exception_depth = depth;
+        success_depth = depth + window;
+    }
+    if (qjsjit_stress_gc(frame) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    switch (opcode) {
+    case OP_for_of_start:
+        status = js_for_of_start(ctx, sp, false);
+        if (status == 0)
+            sp[1] = JS_NewCatchOffset(ctx, 0);
+        break;
+    case OP_for_of_next:
+        status = js_for_of_next(ctx, sp, -3 - (int)operand);
+        break;
+    case OP_for_in_start:
+        status = js_for_in_start(ctx, sp);
+        break;
+    case OP_for_in_next:
+        status = js_for_in_next(ctx, sp);
+        break;
+    default:
+        status = 0;
+        if (!JS_IsUndefined(sp[-3])) {
+            status = JS_IteratorClose(ctx, sp[-3], false);
+            if (status == 0)
+                JS_FreeValue(ctx, sp[-3]);
+        }
+        if (status == 0)
+            sp[-3] = JS_UNDEFINED;
+        break;
+    }
+    if (status < 0) {
+        qjsjit_stress_gc_after_exception(frame);
+        return JS_JIT_HELPER_EXCEPTION;
+    }
+    if (qjsjit_stress_gc(frame) == JS_JIT_HELPER_OK)
+        return JS_JIT_HELPER_OK;
+    /* An allocation failure after a completed operation reports the pending
+     * exception at the interpreter's exception depth for this opcode. */
+    for (i = exception_depth; i < success_depth; i++)
+        qjsjit_consume_slot(ctx, frame->stack_base + i);
+    return JS_JIT_HELPER_EXCEPTION;
+}
+
