+/* ABI 1.25 callback-free native entry. The backend owns the state, which must
+ * stay at a fixed address until runtime_detach returns. QuickJS reads epoch
+ * and updates the counters only on the runtime thread. */
+typedef struct JSJitFastEntryState {
+    uint32_t struct_size;
+    uint32_t reserved;
+    /* Backend-written. Zero disables fast entry. A nonzero value follows the
+     * entry_cache_epoch rules: it never repeats and changes before any
+     * granted handle becomes inadmissible for another call. */
+    uint64_t epoch;
+    uint64_t entries;           /* executions without native_enter */
+    uint64_t exits;             /* DONE exits without native_exit */
+    uint64_t optimized_entries; /* entries granted JS_JIT_FAST_ENTRY_OPTIMIZED */
+} JSJitFastEntryState;
+
+#define JS_JIT_FAST_ENTRY_OPTIMIZED (1U << 0)
+/* OR-ed into native_exit's exit_kind for a non-DONE exit of a fast
+ * execution: that exit has no matching native_enter. */
+#define JS_JIT_EXIT_FAST_UNPAIRED 0x80000000u
+/* Upper bound on one grant; QuickJS rejects larger budgets. */
+#define JS_JIT_FAST_ENTRY_MAX_BUDGET 65536u
+
+typedef struct JSJitFastEntryGrant {
+    uint32_t struct_size;
+    uint32_t budget; /* following executions that may skip the callbacks */
+    uint32_t flags;
+    uint32_t reserved;
+    JSJitFastEntryState *state;
+} JSJitFastEntryGrant;
