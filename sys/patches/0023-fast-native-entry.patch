+/* ABI 1.25: an idle cached pc=0 handle with a remaining backend grant runs
+ * without call feedback, hot, epoch, enter or exit callbacks. The shared
+ * epoch replaces the entry_cache_epoch query; any backend state change that
+ * could make the handle inadmissible advances it first. */
+static inline bool qjsjit_fast_entry_ready(JSRuntime *rt,
+                                           const JSFunctionBytecode *b)
+{
+    const JSJitFastEntryState *state = rt->jit_fast_state;
+    return rt->jit_cached_entry_budget != 0 && state &&
+        rt->jit_cached_entry.pin && b->jit_function_id != 0 &&
+        rt->jit_cached_entry_id == b->jit_function_id &&
+        rt->jit_cached_entry_generation == b->jit_generation &&
+        !rt->jit_suspended && !b->jit_feedback_disabled &&
+        !rt->jit_entry_cache_suppressed && state->epoch != 0 &&
+        state->epoch == rt->jit_cached_entry_epoch;
+}
+
+/* Called with the backend active and the handle already cached. Any malformed
+ * grant leaves the handle on the full callback path. */
+static void qjsjit_grant_fast_entry(JSRuntime *rt,
+                                    const JSJitBackendVTable *vtable,
+                                    void *opaque, uint64_t id,
+                                    uint64_t generation)
+{
+    JSJitFastEntryGrant grant;
+    const JSJitFastEntryState *state;
+
+    rt->jit_cached_entry_budget = 0;
+    rt->jit_cached_entry_fast_flags = 0;
+    if (!vtable->entry_fast_grant || rt->jit_suspended)
+        return;
+    memset(&grant, 0, sizeof(grant));
+    grant.struct_size = sizeof(grant);
+    vtable->entry_fast_grant(opaque, id, generation, &grant);
+    state = grant.state;
+    if (grant.struct_size != sizeof(grant) || grant.reserved != 0 ||
+        grant.budget == 0 || grant.budget > JS_JIT_FAST_ENTRY_MAX_BUDGET ||
+        (grant.flags & ~JS_JIT_FAST_ENTRY_OPTIMIZED) != 0 || !state ||
+        state->struct_size != sizeof(*state) || state->reserved != 0 ||
+        (rt->jit_fast_state && rt->jit_fast_state != state) ||
+        !rt->jit_cached_entry.pin || rt->jit_cached_entry_id != id ||
+        rt->jit_cached_entry_generation != generation)
+        return;
+    rt->jit_fast_state = grant.state;
+    rt->jit_cached_entry_budget = grant.budget;
+    rt->jit_cached_entry_fast_flags = grant.flags;
+}
