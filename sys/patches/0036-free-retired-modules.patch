diff --git a/quickjs.c b/quickjs.c
--- a/quickjs.c
+++ b/quickjs.c
@@ -35061,6 +35061,185 @@ static void js_free_module_def(JSContext *ctx, JSModuleDef *m)
     js_free(ctx, m);
 }
 
+static bool js_module_list_contains(JSModuleDef **modules, int count,
+                                    JSModuleDef *m)
+{
+    int i;
+    for(i = 0; i < count; i++) {
+        if (modules[i] == m)
+            return true;
+    }
+    return false;
+}
+
+static bool js_module_list_remove(JSModuleDef **modules, int *count,
+                                  JSModuleDef *m)
+{
+    int i;
+    for(i = 0; i < *count; i++) {
+        if (modules[i] == m) {
+            modules[i] = modules[--(*count)];
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool js_module_is_retirable(JSModuleDef *m, int owned_references)
+{
+    return JS_REF_COUNT(m) <= owned_references && !m->async_evaluation &&
+        (m->status == JS_MODULE_STATUS_UNLINKED ||
+         m->status == JS_MODULE_STATUS_LINKED ||
+         m->status == JS_MODULE_STATUS_EVALUATED);
+}
+
+static int js_module_ns_autoinit_count(JSModuleDef *m)
+{
+    JSShape *sh;
+    JSShapeProperty *prs;
+    int i, count = 0;
+
+    if (JS_VALUE_GET_TAG(m->module_ns) != JS_TAG_OBJECT)
+        return 0;
+    sh = JS_VALUE_GET_OBJ(m->module_ns)->shape;
+    for(i = 0, prs = get_shape_prop(sh); i < sh->prop_count; i++, prs++) {
+        if ((prs->flags & JS_PROP_TMASK) == JS_PROP_AUTOINIT)
+            count++;
+    }
+    return count;
+}
+
+static int js_materialize_module_ns_property(JSContext *ctx, JSModuleDef *m,
+                                             JSAtom atom)
+{
+    JSShapeProperty *prs;
+    JSProperty *pr;
+    JSValue value;
+
+    prs = find_own_property(&pr, JS_VALUE_GET_OBJ(m->module_ns), atom);
+    if (!prs || (prs->flags & JS_PROP_TMASK) != JS_PROP_AUTOINIT)
+        return 0;
+    if (js_autoinit_get_id(pr) == JS_AUTOINIT_ID_MODULE_NS) {
+        value = JS_GetModuleNamespace(ctx, pr->u.init.opaque);
+        if (JS_IsException(value)) {
+            JS_FreeValue(ctx, JS_GetException(ctx));
+            return -1;
+        }
+        JS_FreeValue(ctx, value);
+    }
+    value = JS_GetProperty(ctx, m->module_ns, atom);
+    if (JS_IsException(value)) {
+        JS_FreeValue(ctx, JS_GetException(ctx));
+        return -1;
+    }
+    JS_FreeValue(ctx, value);
+    return 0;
+}
+
+static int js_materialize_module_ns(JSContext *ctx, JSModuleDef *m)
+{
+    JSShape *sh;
+    JSShapeProperty *prs;
+    JSAtom *atoms;
+    int i, count, ret;
+
+    count = js_module_ns_autoinit_count(m);
+    if (count == 0)
+        return 0;
+    atoms = js_malloc(ctx, sizeof(atoms[0]) * count);
+    if (!atoms)
+        return -1;
+    sh = JS_VALUE_GET_OBJ(m->module_ns)->shape;
+    count = 0;
+    for(i = 0, prs = get_shape_prop(sh); i < sh->prop_count; i++, prs++) {
+        if ((prs->flags & JS_PROP_TMASK) == JS_PROP_AUTOINIT)
+            atoms[count++] = JS_DupAtom(ctx, prs->atom);
+    }
+    ret = 0;
+    for(i = 0; i < count; i++) {
+        if (ret == 0 && js_materialize_module_ns_property(ctx, m, atoms[i]) < 0)
+            ret = -1;
+        JS_FreeAtom(ctx, atoms[i]);
+    }
+    js_free(ctx, atoms);
+    if (ret == 0 && js_module_ns_autoinit_count(m) != 0)
+        ret = -1;
+    return ret;
+}
+
+static int js_module_ns_created_count(JSModuleDef **modules, int count)
+{
+    int i, created = 0;
+    for(i = 0; i < count; i++) {
+        if (JS_VALUE_GET_TAG(modules[i]->module_ns) == JS_TAG_OBJECT)
+            created++;
+    }
+    return created;
+}
+
+size_t JS_FreeRetiredModules(JSContext *ctx,
+                             bool (*is_retired)(const char *module_name,
+                                                void *opaque),
+                             void *opaque, int owned_references)
+{
+    struct list_head *el;
+    JSModuleDef **candidates = NULL;
+    int count = 0, size = 0, created, i;
+    bool changed;
+
+    list_for_each(el, &ctx->loaded_modules) {
+        JSModuleDef *m = list_entry(el, JSModuleDef, link);
+        const char *name;
+        bool retired;
+
+        if (!js_module_is_retirable(m, owned_references))
+            continue;
+        name = JS_AtomToCString(ctx, m->module_name);
+        if (!name)
+            continue;
+        retired = is_retired(name, opaque);
+        JS_FreeCString(ctx, name);
+        if (!retired)
+            continue;
+        if (js_resize_array(ctx, (void **)&candidates, sizeof(candidates[0]),
+                            &size, count + 1)) {
+            js_free(ctx, candidates);
+            return 0;
+        }
+        candidates[count++] = m;
+    }
+
+    do {
+        changed = false;
+        list_for_each(el, &ctx->loaded_modules) {
+            JSModuleDef *m = list_entry(el, JSModuleDef, link);
+            if (js_module_list_contains(candidates, count, m))
+                continue;
+            for(i = 0; i < m->req_module_entries_count; i++)
+                changed |= js_module_list_remove(candidates, &count,
+                                                 m->req_module_entries[i].module);
+            for(i = 0; i < m->async_parent_modules_count; i++)
+                changed |= js_module_list_remove(candidates, &count,
+                                                 m->async_parent_modules[i]);
+            changed |= js_module_list_remove(candidates, &count, m->cycle_root);
+        }
+    } while (changed);
+
+    do {
+        created = js_module_ns_created_count(candidates, count);
+        for(i = 0; i < count; i++) {
+            if (js_materialize_module_ns(ctx, candidates[i]) < 0) {
+                js_free(ctx, candidates);
+                return 0;
+            }
+        }
+    } while (js_module_ns_created_count(candidates, count) != created);
+    for(i = 0; i < count; i++)
+        js_free_module_def(ctx, candidates[i]);
+    js_free(ctx, candidates);
+    return count;
+}
+
