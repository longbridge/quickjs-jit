+JSJitHelperStatus JS_JitInlineEnter(JSJitExecFrame *caller,
+    uint32_t stack_map_id, uint32_t call_pc, uint32_t continuation_pc,
+    uint32_t call_kind, uint32_t argc, JSJitExecFrame **callee)
+{
+    JSFunctionBytecode *caller_b, *b;
+    JSStackFrame *caller_sf;
+    JSJitInlineState *state;
+    JSRuntime *rt;
+    JSValue *operands;
+    JSObject *function;
+    uint32_t opcode, encoded_argc, operands_count, depth, arg_slots, i;
+    size_t value_count, bytes;
+    uint64_t caller_generation, cookie;
+    JSJitHelperStatus status;
+
+    if (!callee)
+        return qjsjit_reject_helper(caller, "missing inline frame output");
+    *callee = NULL;
+    if (qjsjit_validate_helper_frame(caller, true, stack_map_id,
+                                    &caller_b, &caller_sf) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    rt = caller->rt;
+    if (call_kind > JS_JIT_INLINE_CALL_METHOD || argc > UINT16_MAX)
+        return JS_JIT_HELPER_GUARD_MISS;
+    if (call_pc >= (uint32_t)caller_b->byte_code_len ||
+        continuation_pc >= (uint32_t)caller_b->byte_code_len ||
+        !qjsjit_valid_pc(caller_b, caller_b->byte_code_buf + call_pc, false) ||
+        !qjsjit_valid_pc(caller_b, caller_b->byte_code_buf + continuation_pc, false) ||
+        caller->pc != caller_b->byte_code_buf + call_pc)
+        return qjsjit_reject_helper(caller, "invalid inline call PC");
+    opcode = caller_b->byte_code_buf[call_pc];
+    if (opcode >= OP_call0 && opcode <= OP_call3) {
+        encoded_argc = opcode - OP_call0;
+        if (call_kind != JS_JIT_INLINE_CALL)
+            return qjsjit_reject_helper(caller, "inline call kind mismatch");
+    } else if (opcode == OP_call || opcode == OP_call_method) {
+        encoded_argc = get_u16(caller_b->byte_code_buf + call_pc + 1);
+        if ((opcode == OP_call_method) != (call_kind == JS_JIT_INLINE_CALL_METHOD))
+            return qjsjit_reject_helper(caller, "inline call kind mismatch");
+    } else {
+        /* Constructors, tail calls, generators and eval require their own
+         * activation contracts. Decline before any callee effect. */
+        return JS_JIT_HELPER_GUARD_MISS;
+    }
+    if (encoded_argc != argc ||
+        continuation_pc != call_pc + qjsjit_opcode_table[opcode].size)
+        return qjsjit_reject_helper(caller, "invalid inline continuation");
+    operands_count = argc + 1 + (call_kind == JS_JIT_INLINE_CALL_METHOD);
+    depth = (uint32_t)(caller->stack_top - caller->stack_base);
+    if (depth < operands_count || depth > caller_b->stack_size ||
+        !qjsjit_scratch_is_clear(caller->stack_base, caller_b))
+        return qjsjit_reject_helper(caller, "invalid inline call stack");
+    operands = caller->stack_top - operands_count;
+    if (JS_VALUE_GET_TAG(operands[call_kind == JS_JIT_INLINE_CALL_METHOD]) != JS_TAG_OBJECT)
+        return JS_JIT_HELPER_GUARD_MISS;
+    function = JS_VALUE_GET_OBJ(operands[call_kind == JS_JIT_INLINE_CALL_METHOD]);
+    if (function->class_id != JS_CLASS_BYTECODE_FUNCTION)
+        return JS_JIT_HELPER_GUARD_MISS;
+    b = function->u.func.function_bytecode;
+    if (b->func_kind != JS_FUNC_NORMAL ||
+        qjsjit_ensure_function_identity(rt, b) < 0)
+        return JS_JIT_HELPER_GUARD_MISS;
+    arg_slots = max_int((int)argc, b->arg_count);
+    value_count = (size_t)arg_slots + b->var_count + b->stack_size +
+        JS_JIT_HELPER_SCRATCH_SLOTS;
+    if (value_count > JS_JIT_INLINE_MAX_BYTES / sizeof(JSValue))
+        return JS_JIT_HELPER_GUARD_MISS;
+    bytes = sizeof(*state) + value_count * sizeof(JSValue) +
+        (size_t)b->var_ref_count * sizeof(JSVarRef *);
+    if (rt->jit_inline_depth >= JS_JIT_INLINE_MAX_DEPTH ||
+        bytes > JS_JIT_INLINE_MAX_BYTES ||
+        rt->jit_inline_bytes > JS_JIT_INLINE_MAX_BYTES - bytes ||
+        rt->jit_next_frame_cookie == UINT64_MAX)
+        return JS_JIT_HELPER_GUARD_MISS;
+    /* Unlike js_malloc(ctx), this does not manufacture an OOM exception for
+     * an optional optimization. Quota/allocation failure is pre-effect miss. */
+    state = js_mallocz_rt(rt, bytes);
+    if (!state)
+        return JS_JIT_HELPER_GUARD_MISS;
+    /* Every decline happens before this exactly-once entry checkpoint: a
+     * fallback JS_CallInternal will perform its own poll. Reserve the cookie
+     * and quota before reentrancy, but publish no uninitialized frame/owners. */
+    cookie = ++rt->jit_next_frame_cookie;
+    rt->jit_inline_depth++;
+    rt->jit_inline_bytes += bytes;
+    caller_generation = caller->generation;
+    caller_sf->cur_pc = caller_b->byte_code_buf + continuation_pc;
+    status = JS_JIT_HELPER_EXCEPTION;
+    if (js_poll_interrupts(caller->ctx))
+        goto poll_failed;
+    if (caller->generation != caller_generation) {
+        qjsjit_reject_helper(caller, "inline callback changed native identity");
+        goto poll_failed;
+    }
+    /* Invalidation may retire this pin's generation while immutable bytecode
+     * and its rooted physical frame remain valid. Validate every other field
+     * against current runtime state, then retain the pin's original identity. */
+    caller->generation = caller_b->jit_generation;
+    status = qjsjit_validate_helper_frame(caller, true, stack_map_id,
+                                          &caller_b, &caller_sf);
+    caller->generation = caller_generation;
+    if (status < 0)
+        goto poll_failed;
+    state->bytes = bytes;
+    state->previous = rt->jit_inline_top;
+    state->caller = caller;
+    state->root = state->previous && &state->previous->view == caller ?
+        state->previous->root : caller;
+    state->caller_sf = caller_sf;
+    state->call_base = depth - operands_count;
+    state->call_operands = operands_count;
+    state->continuation_pc = continuation_pc;
+    state->argc = argc;
+    state->function_id = b->jit_function_id;
+    state->generation = b->jit_generation;
+    state->argument_slots = arg_slots;
+    state->value_count = (uint32_t)value_count;
+    state->values = (JSValue *)(state + 1);
+    for (i = 0; i < value_count; i++)
+        state->values[i] = JS_UNDEFINED;
+    for (i = 0; i < argc; i++)
+        state->values[i] = js_dup((caller->stack_top - argc)[i]);
+    state->this_value = call_kind == JS_JIT_INLINE_CALL_METHOD ?
+        js_dup(operands[0]) : JS_UNDEFINED;
+    state->new_target = JS_UNDEFINED;
+    state->sf.cur_func = js_dup(operands[call_kind == JS_JIT_INLINE_CALL_METHOD]);
+    state->sf.arg_buf = state->values;
+    state->sf.arg_count = arg_slots;
+    state->sf.var_buf = state->values + arg_slots;
+    state->sf.var_refs = (JSVarRef **)(state->values + value_count);
+    state->sf.var_ref_count = b->var_ref_count;
+    state->sf.is_strict_mode = b->is_strict_mode;
+    state->sf.prev_frame = caller_sf;
+    state->sf.cur_pc = b->byte_code_buf;
+    state->view = *caller;
+    state->view.flags = (caller->flags & JS_JIT_FRAME_STRESS_GC) |
+        (b->is_strict_mode ? JS_JIT_FUNCTION_STRICT : 0);
+    state->view.ctx = b->realm;
+    state->view.function_id = b->jit_function_id;
+    state->view.generation = b->jit_generation;
+    state->view.arg_buf = state->sf.arg_buf;
+    state->view.var_buf = state->sf.var_buf;
+    state->view.stack_base = state->sf.var_buf + b->var_count;
+    state->view.stack_top = state->view.stack_base;
+    state->view.stack_capacity = state->view.stack_base + b->stack_size +
+        JS_JIT_HELPER_SCRATCH_SLOTS;
+    state->view.bytecode_start = b->byte_code_buf;
+    state->view.pc = b->byte_code_buf;
+    state->view.frame_cookie = cookie;
+    caller_sf->cur_pc = caller_b->byte_code_buf + continuation_pc;
+    rt->jit_inline_top = state;
+    rt->current_stack_frame = &state->sf;
+    qjsjit_inline_activate(rt, &state->view);
+    *callee = &state->view;
+    return JS_JIT_HELPER_OK;
+poll_failed:
+    rt->jit_inline_depth--;
+    rt->jit_inline_bytes -= bytes;
+    js_free_rt(rt, state);
+    return JS_JIT_HELPER_EXCEPTION;
+}
+
+/* Complete the parent CALL with exactly the same success/throw stack effects
+ * as the interpreter. The duplicated/moved result remains rooted while owners
+ * in the callee and parent call operands are released. */
+static void qjsjit_inline_complete(JSJitInlineState *state, JSValue result)
+{
+    JSJitExecFrame *caller = state->caller;
+    JSRuntime *rt = caller->rt;
+    uint32_t base = state->call_base, count = state->call_operands, i;
+    const uint8_t *pc = caller->bytecode_start + state->continuation_pc;
+    qjsjit_inline_destroy(rt, state);
+    caller->pc = pc;
+    rt->current_stack_frame->cur_pc = (uint8_t *)pc;
+    if (!JS_IsException(result)) {
+        for (i = 0; i < count; i++)
+            qjsjit_consume_slot(caller->ctx, caller->stack_base + base + i);
+        caller->stack_base[base] = result;
+        caller->stack_top = caller->stack_base + base + 1;
+    }
+}
+
+JSJitHelperStatus JS_JitInlineLeave(JSJitExecFrame *callee, uint32_t result_slot)
+{
+    JSFunctionBytecode *b;
+    JSStackFrame *sf;
+    JSValue *result;
+    if (qjsjit_validate_helper_frame(callee, false, 0, &b, &sf) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    if (!callee->rt->jit_inline_top ||
+        &callee->rt->jit_inline_top->view != callee ||
+        !qjsjit_resolve_slot(callee, b, result_slot, &result) ||
+        JS_IsException(*result))
+        return qjsjit_reject_helper(callee, "invalid inline return");
+    qjsjit_inline_complete(callee->rt->jit_inline_top, js_dup(*result));
+    return JS_JIT_HELPER_OK;
+}
+
+JSJitHelperStatus JS_JitInlineResume(JSJitExecFrame *callee,
+    uint32_t resume_pc, uint32_t resume_kind)
+{
+    JSFunctionBytecode *b;
+    JSStackFrame *sf;
+    JSRuntime *rt;
+    JSJitExecFrame *root;
+    JSJitInlineState *state;
+    JSValue result;
+    if (qjsjit_validate_helper_frame_state(callee, false, 0, &b, &sf,
+                                          QJSJIT_VALIDATE_RESUME) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    rt = callee->rt;
+    state = rt->jit_inline_top;
+    if (!state || &state->view != callee ||
+        resume_kind > JS_JIT_INLINE_RESUME_EXCEPTION ||
+        (resume_kind == JS_JIT_INLINE_RESUME_EXCEPTION) != JS_HasException(callee->ctx) ||
+        resume_pc > (uint32_t)b->byte_code_len ||
+        !qjsjit_valid_pc(b, b->byte_code_buf + resume_pc,
+                         resume_kind == JS_JIT_INLINE_RESUME_EXCEPTION) ||
+        !qjsjit_valid_stack_top(callee->stack_base, b->stack_size, callee->stack_top) ||
+        !qjsjit_scratch_is_clear(callee->stack_base, b))
+        return qjsjit_reject_helper(callee, "invalid inline resume state");
+    root = state->root;
+    callee->pc = b->byte_code_buf + resume_pc;
+    do {
+        state = rt->jit_inline_top;
+        state->resumed_exception = JS_HasException(state->view.ctx);
+        /* Interpreter PC/SP now live in its C dispatch locals. Reentrant
+         * callbacks must not use the stale native helper view while it runs. */
+        qjsjit_inline_activate(rt, NULL);
+        result = JS_CallInternalResume(state->view.ctx, state->sf.cur_func,
+            state->this_value, state->new_target, state->argc,
+            (JSValueConst *)state->values, 0, state);
+        qjsjit_inline_complete(state, result);
+    } while (rt->jit_inline_top && rt->jit_inline_top->root == root);
+    return JS_IsException(result) ? JS_JIT_HELPER_EXCEPTION : JS_JIT_HELPER_OK;
+}
+
+JSJitHelperStatus JS_JitInlineCheck(JSJitExecFrame *frame)
+{
+    JSFunctionBytecode *b;
+    JSStackFrame *sf;
+    JSJitInlineState *state;
+    JSJitExecFrame *root;
+    if (qjsjit_validate_helper_frame_state(frame, false, 0, &b, &sf,
+                                          QJSJIT_VALIDATE_CHECK) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    if (frame->generation != b->jit_generation)
+        return JS_JIT_HELPER_GUARD_MISS;
+    state = frame->rt->jit_inline_top;
+    if (!state || &state->view != frame)
+        return JS_JIT_HELPER_OK; /* physical root after Leave */
+    root = state->root;
+    do {
+        JSObject *function = JS_VALUE_GET_OBJ(state->sf.cur_func);
+        b = function->u.func.function_bytecode;
+        if (state->view.function_id != state->function_id ||
+            state->view.generation != state->generation)
+            return qjsjit_reject_helper(frame, "invalid inline checkpoint identity");
+        if (b->jit_generation != state->generation)
+            return JS_JIT_HELPER_GUARD_MISS;
+        if (state->caller == root) {
+            function = JS_VALUE_GET_OBJ(state->caller_sf->cur_func);
+            b = function->u.func.function_bytecode;
+            return b->jit_generation == root->generation ?
+                JS_JIT_HELPER_OK : JS_JIT_HELPER_GUARD_MISS;
+        }
+        state = state->previous;
+    } while (state && state->root == root);
+    return qjsjit_reject_helper(frame, "incomplete inline checkpoint chain");
+}
