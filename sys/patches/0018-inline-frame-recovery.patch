+/* Free only runtime-owned storage, never a pointer supplied in the mutable
+ * public view. Interpreter completion has already consumed its local range. */
+static void qjsjit_inline_destroy(JSRuntime *rt, JSJitInlineState *state)
+{
+    uint32_t i;
+    if (!state->values_consumed) {
+        if (state->sf.var_ref_count)
+            close_var_refs(rt, &state->sf);
+        for (i = 0; i < state->value_count; i++)
+            JS_FreeValueRT(rt, state->values[i]);
+    }
+    rt->jit_inline_top = state->previous;
+    rt->current_stack_frame = state->caller_sf;
+    qjsjit_inline_activate(rt, state->caller);
+    rt->jit_inline_depth--;
+    rt->jit_inline_bytes -= state->bytes;
+    JS_FreeValueRT(rt, state->sf.cur_func);
+    JS_FreeValueRT(rt, state->this_value);
+    JS_FreeValueRT(rt, state->new_target);
+    js_free_rt(rt, state);
+}
