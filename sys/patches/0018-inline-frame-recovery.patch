+static void qjsjit_inline_activate(JSRuntime *rt, JSJitExecFrame *view)
+{
+    rt->jit_active_frame = view;
+    rt->jit_active_frame_cookie = view ? view->frame_cookie : 0;
+    rt->jit_active_stack_map_count = view ? view->entry.stack_map_count : 0;
+    rt->jit_active_helper_abi_version = view ? view->entry.helper_abi_version : 0;
+}
