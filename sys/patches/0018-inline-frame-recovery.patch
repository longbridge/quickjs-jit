+/* Native code must never leave a live shadow frame behind. Reject without
+ * replay, and release all its owners before restoring the physical C frame. */
+static bool qjsjit_inline_abort_root(JSJitExecFrame *root)
+{
+    JSRuntime *rt = root->rt;
+    bool found = false;
+    while (rt->jit_inline_top && rt->jit_inline_top->root == root) {
+        found = true;
+        qjsjit_inline_destroy(rt, rt->jit_inline_top);
+    }
+    return found;
+}
