+JSJitHelperStatus JS_JitHelperCallConstructor(
+    JSJitExecFrame *frame, uint32_t stack_map_id, uint32_t output,
+    uint32_t function, uint32_t new_target, uint32_t argv, uint32_t argc)
+{
+    JSFunctionBytecode *b;
+    JSStackFrame *sf;
+    JSValue *out, *func, *target, *args = NULL, *slot;
+    JSValue result;
+    uint32_t i;
+
+    if (qjsjit_validate_helper_frame(frame, true, stack_map_id, &b, &sf) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    qjsjit_count_helper(frame, JS_JIT_HELPER_CALL_CONSTRUCTOR);
+    if (!qjsjit_resolve_slot(frame, b, output, &out) ||
+        !qjsjit_resolve_slot(frame, b, function, &func) ||
+        !qjsjit_resolve_slot(frame, b, new_target, &target) ||
+        out == func || out == target || argc > INT_MAX)
+        return qjsjit_reject_helper(frame, "invalid JIT constructor slots");
+    if (argc == 0) {
+        if (argv != JS_JIT_SLOT_NONE)
+            return qjsjit_reject_helper(frame, "invalid empty JIT constructor argv");
+    } else {
+        if (!qjsjit_resolve_slot(frame, b, argv, &args))
+            return qjsjit_reject_helper(frame, "invalid JIT constructor argv");
+        for (i = 0; i < argc; i++) {
+            if (!qjsjit_resolve_slot(frame, b, argv + i, &slot) ||
+                slot != args + i || out == slot)
+                return qjsjit_reject_helper(frame, "invalid JIT constructor argv range");
+        }
+    }
+    if (!JS_IsUndefined(*out))
+        return qjsjit_reject_helper(frame, "occupied JIT constructor output");
+    if (qjsjit_stress_gc(frame) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    result = JS_CallConstructorInternal(frame->ctx, *func, *target, (int)argc,
+                                        (JSValueConst *)args, 0);
+    if (JS_IsException(result)) {
+        *out = JS_UNDEFINED;
+        qjsjit_stress_gc_after_exception(frame);
+        return JS_JIT_HELPER_EXCEPTION;
+    }
+    *out = result;
+    return qjsjit_finish_output(frame, out);
+}
 #endif
 
