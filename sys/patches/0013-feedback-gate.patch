+/* Check before collecting operand types; slow arithmetic can reenter the VM,
+   so recording checks the current backend state again after the operation. */
+static inline bool qjsjit_feedback_enabled(JSRuntime *rt, JSFunctionBytecode *b)
+{
+    return rt->jit_backend_vtable && !rt->jit_suspended &&
+           !b->jit_feedback_disabled && rt->jit_backend_vtable->record_feedback;
+}
+
 static void qjsjit_record_feedback(JSRuntime *rt, JSFunctionBytecode *b,
                                    uint32_t kind, uint32_t pc,
                                    uint32_t slot, const uint32_t *types,
@@ -2473,7 +2481,10 @@
