 #ifdef CONFIG_JIT_ABI
-#define QJSJIT_CMP_DECLARE uint32_t jit_lhs_type, jit_rhs_type;
-#define QJSJIT_CMP_CAPTURE(op1, op2)                       \
-                jit_lhs_type = qjsjit_feedback_type(op1); \
-                jit_rhs_type = qjsjit_feedback_type(op2);
-#define QJSJIT_CMP_RECORD()                                \
