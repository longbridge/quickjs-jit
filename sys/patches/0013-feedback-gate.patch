 {
     uint32_t types[3], flags = 0;
-    int result_tag = JS_VALUE_GET_TAG(result);
+    int result_tag;
+    if (!qjsjit_feedback_enabled(rt, b))
+        return;
+    result_tag = JS_VALUE_GET_TAG(result);
     types[0] = lhs_type;
     types[1] = rhs_type;
     types[2] = qjsjit_feedback_type(result);
