+/* Exact interpreter slow paths for the non-add binary arithmetic and bitwise
+ * opcodes. The operands occupy two adjacent slots and the result replaces the
+ * left one, exactly as in the interpreter: the slow path consumes both
+ * operands on success and on language exception, so the adapter only clears
+ * the stale right slot and never frees either operand itself. */
+JSJitHelperStatus JS_JitHelperBinaryArithSlow(JSJitExecFrame *frame,
+                                              uint32_t stack_map_id,
+                                              uint32_t output, uint32_t left,
+                                              uint32_t right, uint32_t opcode)
+{
+    JSFunctionBytecode *b;
+    JSStackFrame *sf;
+    JSValue *out, *lhs, *rhs;
+    int status;
+
+    if (qjsjit_validate_helper_frame(frame, true, stack_map_id, &b, &sf) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    qjsjit_count_helper(frame, JS_JIT_HELPER_BINARY_ARITH_SLOW);
+    if (!qjsjit_resolve_slot(frame, b, output, &out) ||
+        !qjsjit_resolve_slot(frame, b, left, &lhs) ||
+        !qjsjit_resolve_slot(frame, b, right, &rhs) ||
+        out != lhs || rhs != lhs + 1)
+        return qjsjit_reject_helper(frame, "invalid JIT binary slots");
+    switch (opcode) {
+    case OP_sub:
+    case OP_mul:
+    case OP_div:
+    case OP_mod:
+    case OP_pow:
+    case OP_shl:
+    case OP_sar:
+    case OP_shr:
+    case OP_and:
+    case OP_or:
+    case OP_xor:
+        break;
+    default:
+        return qjsjit_reject_helper(frame, "invalid JIT binary opcode");
+    }
+    if (qjsjit_stress_gc(frame) < 0) {
+        qjsjit_consume_slot(frame->ctx, lhs);
+        qjsjit_consume_slot(frame->ctx, rhs);
+        return JS_JIT_HELPER_EXCEPTION;
+    }
+    switch (opcode) {
+    case OP_shr:
+        status = js_shr_slow(frame->ctx, rhs + 1);
+        break;
+    case OP_shl:
+    case OP_sar:
+    case OP_and:
+    case OP_or:
+    case OP_xor:
+        status = js_binary_logic_slow(frame->ctx, rhs + 1, (OPCodeEnum)opcode);
+        break;
+    default:
+        status = js_binary_arith_slow(frame->ctx, rhs + 1, (OPCodeEnum)opcode);
+        break;
+    }
+    *rhs = JS_UNDEFINED;
+    if (status < 0) {
+        *out = JS_UNDEFINED;
+        qjsjit_stress_gc_after_exception(frame);
+        return JS_JIT_HELPER_EXCEPTION;
+    }
+    return qjsjit_finish_output(frame, out);
+}
+
+/* Exact interpreter slow paths for the unary arithmetic opcodes. The input
+ * is moved into the output slot first so the only owner stays in a
+ * C-visible frame slot across user coercion, allocation, and re-entrancy;
+ * the slow path consumes it on both success and language exception. */
+JSJitHelperStatus JS_JitHelperUnaryArithSlow(JSJitExecFrame *frame,
+                                             uint32_t stack_map_id,
+                                             uint32_t output, uint32_t input,
+                                             uint32_t opcode)
+{
+    JSFunctionBytecode *b;
+    JSStackFrame *sf;
+    JSValue *out, *in;
+    int status;
+
+    if (qjsjit_validate_helper_frame(frame, true, stack_map_id, &b, &sf) < 0)
+        return JS_JIT_HELPER_EXCEPTION;
+    qjsjit_count_helper(frame, JS_JIT_HELPER_UNARY_ARITH_SLOW);
+    if (!qjsjit_resolve_slot(frame, b, output, &out) ||
+        !qjsjit_resolve_slot(frame, b, input, &in))
+        return qjsjit_reject_helper(frame, "invalid JIT unary slots");
+    switch (opcode) {
+    case OP_neg:
+    case OP_inc:
+    case OP_dec:
+    case OP_plus:
+    case OP_not:
+        break;
+    default:
+        return qjsjit_reject_helper(frame, "invalid JIT unary opcode");
+    }
+    if (out != in && !JS_IsUndefined(*out))
+        return qjsjit_reject_helper(frame, "occupied JIT unary output");
+    if (qjsjit_stress_gc(frame) < 0) {
+        qjsjit_consume_slot(frame->ctx, in);
+        return JS_JIT_HELPER_EXCEPTION;
+    }
+    if (out != in) {
+        *out = *in;
+        *in = JS_UNDEFINED;
+    }
+    if (opcode == OP_not)
+        status = js_not_slow(frame->ctx, out + 1);
+    else
+        status = js_unary_arith_slow(frame->ctx, out + 1, (OPCodeEnum)opcode);
+    if (status < 0) {
+        qjsjit_stress_gc_after_exception(frame);
+        return JS_JIT_HELPER_EXCEPTION;
+    }
+    return qjsjit_finish_output(frame, out);
+}
