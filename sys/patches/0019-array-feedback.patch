+static void qjsjit_record_array_feedback(JSRuntime *rt, JSFunctionBytecode *b,
+                                        uint32_t pc, JSValueConst receiver,
+                                        uint32_t flags)
+{
+    uint32_t mode = JS_JIT_ARRAY_MODE_GENERIC;
+    JSObject *object;
+    JSTypedArray *typed;
+    JSArrayBuffer *buffer;
+
+    if (!qjsjit_feedback_enabled(rt, b))
+        return;
+    if (JS_VALUE_GET_TAG(receiver) == JS_TAG_OBJECT) {
+        object = JS_VALUE_GET_OBJ(receiver);
+        switch (object->class_id) {
+        case JS_CLASS_ARRAY:
+            if (object->fast_array)
+                mode = JS_JIT_ARRAY_MODE_PACKED;
+            else
+                flags |= JS_JIT_FEEDBACK_ARRAY_SLOW;
+            break;
+        case JS_CLASS_INT32_ARRAY:
+        case JS_CLASS_FLOAT64_ARRAY:
+            mode = object->class_id == JS_CLASS_INT32_ARRAY ?
+                JS_JIT_ARRAY_MODE_INT32 : JS_JIT_ARRAY_MODE_FLOAT64;
+            typed = object->u.typed_array;
+            if (!object->fast_array || !typed || !typed->buffer ||
+                (typed->buffer->class_id != JS_CLASS_ARRAY_BUFFER &&
+                 typed->buffer->class_id != JS_CLASS_SHARED_ARRAY_BUFFER) ||
+                !(buffer = typed->buffer->u.array_buffer)) {
+                flags |= JS_JIT_FEEDBACK_ARRAY_INVALID_BACKING;
+                break;
+            }
+            /* Fixed-length views over RABs need not have track_rab set. */
+            if (typed->track_rab || buffer->max_byte_length >= 0)
+                flags |= JS_JIT_FEEDBACK_ARRAY_RESIZABLE;
+            if (buffer->detached)
+                flags |= JS_JIT_FEEDBACK_ARRAY_DETACHED;
+            if (buffer->immutable)
+                flags |= JS_JIT_FEEDBACK_ARRAY_IMMUTABLE;
+            if (buffer->shared)
+                flags |= JS_JIT_FEEDBACK_ARRAY_SHARED;
+            break;
+        default:
+            /* Built-in supported arrays are exotic too; only unsupported
+             * receiver classes contribute the EXOTIC hazard here. */
+            if (object->is_exotic)
+                flags |= JS_JIT_FEEDBACK_ARRAY_EXOTIC;
+            break;
+        }
+    }
+    qjsjit_record_feedback(rt, b, JS_JIT_FEEDBACK_ARRAY, pc, mode,
+                            NULL, 0, flags);
+}
