+/* ARRAY observes the receiver before any property lookup, coercion or store.
+ * slot is JSJitArrayMode, type_count is zero, and flags describe the access
+ * and observed hazards. These are profiles, never continuing-path guards. */
+typedef enum JSJitArrayMode {
+    JS_JIT_ARRAY_MODE_GENERIC = 0,
+    JS_JIT_ARRAY_MODE_PACKED = 1,
+    JS_JIT_ARRAY_MODE_INT32 = 2,
+    JS_JIT_ARRAY_MODE_FLOAT64 = 3,
+} JSJitArrayMode;
