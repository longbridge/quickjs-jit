+/* Versioned, read-only continuing-path guard for typed-array loads and
+ * length reads. effects == 0 promises no allocation, throw, finalization or
+ * reentry. Feedback may select a candidate but must never replace this live
+ * validation. A miss leaves the metadata payload zeroed. */
+#define QJSJIT_ARRAY_API_VERSION 1u
+#define JS_JIT_ARRAY_QUERY_LENGTH (1U << 0)
+
+typedef enum JSJitArrayQueryStatus {
+    JS_JIT_ARRAY_QUERY_INVALID = -1,
+    JS_JIT_ARRAY_QUERY_MISS = 0,
+    JS_JIT_ARRAY_QUERY_OK = 1,
+} JSJitArrayQueryStatus;
+
+typedef struct JSJitArrayMetadata {
+    uint32_t struct_size;
+    uint32_t mode;
+    uint32_t count;
+    uint32_t reserved;
+    void *data;
+} JSJitArrayMetadata;
+
+typedef int JSJitArrayQueryFunc(JSContext *ctx, const JSValue *receiver,
+                                uint32_t expected_mode, uint32_t flags,
+                                JSJitArrayMetadata *out);
+
+typedef struct JSJitArrayAPI {
+    uint32_t struct_size;
+    uint32_t version;
+    uint32_t effects;
+    uint32_t reserved;
+    JSJitArrayQueryFunc *query;
+} JSJitArrayAPI;
+
+JS_EXTERN const JSJitArrayAPI *JS_JitGetArrayAPI(uint32_t version);
